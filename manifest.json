{
  "manifest_version": 2,
  "name": "uSpot - Spotify Adblocker",
  "version": "3.2",
  "description": "A browser extension that blocks Spotify web audio ads using the uBlock mv2 approach: blocked ads are replaced with a silent 1-second placeholder. Optional page hook and daily-updated host list.",
  "browser_specific_settings": {
    "gecko": {
      "id": "spotify-adblock-ublock-method-mv2@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "alarms",
    "*://*.scdn.co/*",
    "*://*.spotifycdn.com/*",
    "*://*.spotify.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*",
    "*://*.fastly-insights.com/*",
    "*://*.sentry.io/*",
    "*://*.2mdn.net/*",
    "*://*.adxcel.com/*",
    "*://*.amillionads.com/*",
    "https://raw.githubusercontent.com/Myst1cX/uSpot/*"
  ],
  "background": {
    "scripts": [
      "lib/hosts.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "uSpot - Spotify Adblocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    "noop-1s.mp4",
    "empty.txt"
  ],
  "optional_permissions": [
    "<all_urls>"
  ]
}
