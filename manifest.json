{
  "manifest_version": 2,
  "name": "uSpot - Spotify Adblocker",
  "version": "3.1",
  "description": "A browser extension that blocks Spotify web audio ads using the uBlock mv2 approach: blocked ads are replaced with a silent 1-second placeholder.",
  "browser_specific_settings": {
    "gecko": {
      "id": "spotify-adblock-ublock-method-mv2@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "*://*.scdn.co/*",
    "*://*.spotifycdn.com/*",
    "*://open.spotify.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*",
    "*://*.fastly-insights.com/*",
    "*://*.sentry.io/*",
    "*://*.2mdn.net/*",
    "*://*.adxcel.com/*",
    "*://*.amillionads.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "css": ["styles.css"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "uSpot - Spotify Adblocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": ["noop-1s.mp4", "empty.txt"]
}
